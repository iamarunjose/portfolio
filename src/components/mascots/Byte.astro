---
import Mascot from './Mascot.astro';
import type { MascotState } from '../../lib/mascot-animation';

export interface Props {
  id?: string;
  size?: 'sm' | 'md' | 'lg';
  initialState?: MascotState;
  interactive?: boolean;
  showHud?: boolean;
  label?: string;
}

const {
  id = 'mascot-byte',
  size = 'md',
  initialState = 'idle',
  interactive = true,
  showHud = true,
  label = 'BYTE retro CRT computer mascot. Click or press Enter to display HELLO WORLD.'
} = Astro.props;
---

<Mascot
  id={id}
  name="byte"
  displayName="BYTE.CRT"
  defaultStatus="SYSTEM READY"
  size={size}
  initialState={initialState}
  interactive={interactive}
  showHud={showHud}
  label={label}
>
  <svg
    viewBox="0 0 68 64"
    class="mascot-svg mascot-pixel-art"
    aria-hidden="true"
  >
    <!-- Ground Shadow -->
    <rect x="14" y="59" width="40" height="3.5" fill="#171717" opacity="0.25" />

    <!-- Confetti Sparks on Celebrate -->
    <g class="mascot-confetti">
      <rect x="3" y="10" width="5" height="5" fill="#FFDE43" stroke="#171717" stroke-width="1.5" />
      <rect x="59" y="8" width="5" height="5" fill="#FF5793" stroke="#171717" stroke-width="1.5" />
    </g>

    <g class="mascot-body-root">
      <!-- Outer 1980s CRT Monitor Bezel -->
      <rect x="10" y="6" width="48" height="34" fill="#FFFDF9" stroke="#171717" stroke-width="3" />
      <!-- Top Pink Header Strip -->
      <rect x="10" y="6" width="48" height="6" fill="#FF5793" stroke="#171717" stroke-width="2.5" />

      <!-- Turquoise CRT Screen (#38D8C4) -->
      <rect
        class="byte-screen-glow"
        x="15"
        y="15"
        width="38"
        height="20"
        fill="#38D8C4"
        stroke="#171717"
        stroke-width="2.5"
      />

      <!-- Animated CRT Eyes (Pupils track nearby pointer movement via data-byte-pupils) -->
      <g class="mascot-eyes">
        <rect x="20" y="17" width="7" height="7" fill="#171717" />
        <rect x="37" y="17" width="7" height="7" fill="#171717" />
        <g class="byte-pupils" data-byte-pupils>
          <rect x="22" y="19" width="2.5" height="2.5" fill="#FFDE43" />
          <rect x="39" y="19" width="2.5" height="2.5" fill="#FFDE43" />
        </g>
      </g>

      <!-- Dark Terminal Strip + Blinking Green Cursor inside CRT Screen -->
      <rect x="16.5" y="26" width="35" height="7.5" fill="#171717" />
      <text
        x="18.5"
        y="31.5"
        font-family="Space Mono, monospace"
        font-weight="700"
        font-size="4.8"
        fill="#38D8C4"
        data-byte-screen-text
      >
        SYSTEM READY
      </text>
      <rect class="byte-cursor" x="46.5" y="27.5" width="3.5" height="4.5" fill="#00FF66" />

      <!-- Small Side Arms -->
      <g class="mascot-arm-left">
        <rect x="4" y="24" width="6" height="10" fill="#FFDE43" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="mascot-arm-right">
        <rect x="58" y="24" width="6" height="10" fill="#FFDE43" stroke="#171717" stroke-width="2.5" />
      </g>

      <!-- Attached Retro Keyboard Deck -->
      <rect x="8" y="41" width="52" height="10" fill="#FFDE43" stroke="#171717" stroke-width="3" />
      <!-- Pixel Keycaps -->
      <rect x="13" y="44" width="6" height="4" fill="#FFFDF9" stroke="#171717" stroke-width="1.5" />
      <rect x="21" y="44" width="6" height="4" fill="#FF5793" stroke="#171717" stroke-width="1.5" />
      <rect x="29" y="44" width="12" height="4" fill="#FFFDF9" stroke="#171717" stroke-width="1.5" />
      <rect x="43" y="44" width="6" height="4" fill="#377AF5" stroke="#171717" stroke-width="1.5" />
      <rect x="51" y="44" width="5" height="4" fill="#38D8C4" stroke="#171717" stroke-width="1.5" />

      <!-- CRT Feet -->
      <g class="mascot-leg-left">
        <rect x="18" y="51" width="10" height="7" fill="#377AF5" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="mascot-leg-right">
        <rect x="40" y="51" width="10" height="7" fill="#377AF5" stroke="#171717" stroke-width="2.5" />
      </g>
    </g>
  </svg>
</Mascot>

