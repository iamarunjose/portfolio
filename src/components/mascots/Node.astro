---
import Mascot from './Mascot.astro';
import type { MascotState } from '../../lib/mascot-animation';

export interface Props {
  id?: string;
  size?: 'sm' | 'md' | 'lg';
  initialState?: MascotState;
  interactive?: boolean;
  showHud?: boolean;
  label?: string;
}

const {
  id = 'mascot-node',
  size = 'md',
  initialState = 'idle',
  interactive = true,
  showHud = true,
  label = 'NODE knowledge graph explorer mascot. Click or press Enter to pulse and highlight connected graph nodes.'
} = Astro.props;
---

<Mascot
  id={id}
  name="node"
  displayName="NODE.KG"
  defaultStatus="KG // EXPLORER"
  size={size}
  initialState={initialState}
  interactive={interactive}
  showHud={showHud}
  label={label}
>
  <svg
    viewBox="0 0 72 64"
    class="mascot-svg mascot-pixel-art"
    aria-hidden="true"
  >
    <!-- Ground Shadow -->
    <rect x="20" y="58" width="32" height="3.5" fill="#171717" opacity="0.25" />

    <g class="mascot-body-root">
      <!-- Connected Graph Lines Around Head (Draw via stroke-dashoffset) -->
      <line class="node-edge-line" x1="12" y1="12" x2="36" y2="22" stroke="#171717" stroke-width="3" />
      <line class="node-edge-line node-edge-line-2" x1="36" y1="6" x2="36" y2="22" stroke="#171717" stroke-width="3" />
      <line class="node-edge-line node-edge-line-3" x1="60" y1="12" x2="36" y2="22" stroke="#171717" stroke-width="3" />
      <line class="node-edge-line node-edge-line-4" x1="12" y1="12" x2="36" y2="6" stroke="#FF5793" stroke-width="2" stroke-dasharray="3 2" />
      <line class="node-edge-line node-edge-line-5" x1="36" y1="6" x2="60" y2="12" stroke="#38D8C4" stroke-width="2" stroke-dasharray="3 2" />

      <!-- Pulsing Orbiting Graph Nodes -->
      <g class="node-satellite">
        <circle cx="12" cy="12" r="6" fill="#FF5793" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="node-satellite node-satellite-2">
        <circle cx="36" cy="6" r="5.5" fill="#FFDE43" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="node-satellite node-satellite-3">
        <circle cx="60" cy="12" r="6" fill="#38D8C4" stroke="#171717" stroke-width="2.5" />
      </g>

      <!-- Turquoise & Purple/Cobalt Robot Head -->
      <rect x="20" y="18" width="32" height="19" fill="#38D8C4" stroke="#171717" stroke-width="3" />
      <rect x="24" y="22" width="24" height="10" fill="#171717" />

      <!-- Digital Eyes -->
      <g class="mascot-eyes">
        <rect x="27" y="24" width="6" height="6" fill="#38D8C4" />
        <rect x="39" y="24" width="6" height="6" fill="#FFDE43" />
      </g>

      <!-- Arms -->
      <g class="mascot-arm-left">
        <rect x="13" y="38" width="6" height="11" fill="#FFDE43" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="mascot-arm-right">
        <rect x="53" y="38" width="6" height="11" fill="#FF5793" stroke="#171717" stroke-width="2.5" />
      </g>

      <!-- Purple & Cobalt Robot Chassis -->
      <rect x="22" y="37" width="28" height="14" fill="#7C3AED" stroke="#171717" stroke-width="3" />
      <rect x="27" y="40" width="18" height="8" fill="#377AF5" stroke="#171717" stroke-width="2" />
      <circle cx="32" cy="44" r="2" fill="#FFDE43" />
      <circle cx="40" cy="44" r="2" fill="#38D8C4" />
      <line x1="32" y1="44" x2="40" y2="44" stroke="#FFFDF9" stroke-width="1.5" />

      <!-- Legs -->
      <g class="mascot-leg-left">
        <rect x="25" y="51" width="7" height="7" fill="#38D8C4" stroke="#171717" stroke-width="2.5" />
      </g>
      <g class="mascot-leg-right">
        <rect x="40" y="51" width="7" height="7" fill="#38D8C4" stroke="#171717" stroke-width="2.5" />
      </g>
    </g>
  </svg>
</Mascot>

